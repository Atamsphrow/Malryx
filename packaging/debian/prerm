#!/bin/sh
# Pre-suppression : on arrete le service temps reel s'il tourne.
set -e

case "$1" in
  remove|upgrade|deconfigure)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl stop malryx-realtime 2>/dev/null || true
      systemctl disable malryx-realtime 2>/dev/null || true
    fi
    ;;
  failed-upgrade)
    ;;
esac

exit 0
